[importlinter]
root_package = generic_ml_wrapper

# Rule 1 — domain purity. The innermost ring models the world; it must not import
# use cases, ports, the composition root, or any adapter. (The interceptor_chain ->
# port.outbound.interceptor edge this catches was the sole violation at review time,
# fixed by defining the Interceptor abstraction in the domain and having the outbound
# InterceptorPort extend it.)
[importlinter:contract:domain-purity]
name = Domain must not import use cases, ports, wiring, or adapters
type = forbidden
source_modules =
    generic_ml_wrapper.application.domain
forbidden_modules =
    generic_ml_wrapper.application.usecase
    generic_ml_wrapper.application.port
    generic_ml_wrapper.application.wiring
    generic_ml_wrapper.adapter

# Rule 2 — the application ring (domain + use cases + ports) is independent of the
# adapter and composition layers. Dependencies point inward, never outward.
[importlinter:contract:application-ring]
name = Application ring must not import adapters or the composition root
type = forbidden
source_modules =
    generic_ml_wrapper.application.domain
    generic_ml_wrapper.application.usecase
    generic_ml_wrapper.application.port
forbidden_modules =
    generic_ml_wrapper.adapter
    generic_ml_wrapper.application.wiring

# Rule 3 — ports are abstractions; use cases depend on them, never the reverse.
[importlinter:contract:ports-no-usecases]
name = Ports must not import use cases
type = forbidden
source_modules =
    generic_ml_wrapper.application.port
forbidden_modules =
    generic_ml_wrapper.application.usecase

# Rule 4 — the declared top-level shape, exhaustively. Rules 1-3 forbid named edges,
# which constrains only what someone thought to name: a package outside the list (a
# shared kernel, a utils bag) is unpoliced by construction, and that is how `common`
# became an escape hatch. This contract inverts the default — a top-level package that
# is not declared here fails the build, so the next one cannot appear by accident.
#
# `adapter` and `application` are siblings rather than ordered because the composition
# root lives inside `application.wiring` and builds adapters, while the CLI entry point
# reaches back into it to obtain what it runs. That single reverse edge is the CLI/
# composition-root coupling recorded separately; ordering the two here would prejudge
# its fix. Rule 2 already forbids the edges that matter (the application ring reaching
# outward), so nothing enforced today is lost.
#
# `resources` is data (JSON catalogues, packaged templates) with no importable code;
# `_build_info` is the generated version stamp. Neither is a layer.
[importlinter:contract:top-level-shape]
name = Every top-level package is declared; there is no shared kernel
type = layers
containers =
    generic_ml_wrapper
layers =
    adapter : application
exhaustive = true
exhaustive_ignores =
    resources
    _build_info

# Rule 5 — the ring order inside `application`, exhaustively. Rules 1-3 name specific
# forbidden edges; this one fixes the direction once and refuses undeclared siblings,
# so a new sub-package under `application` has to say which ring it belongs to.
[importlinter:contract:application-rings]
name = Application rings are ordered wiring -> usecase -> port -> domain
type = layers
containers =
    generic_ml_wrapper.application
layers =
    wiring
    usecase
    port
    domain
exhaustive = true

# Rule 6 — the two adapter sides are independent. An inbound adapter (CLI, TUI) that
# imports an outbound one is either doing a use case's job itself, or catching a type an
# adapter invented; both couple the delivery mechanism to whichever technology happens
# to be installed today. Everything the CLI needs from the outside comes back through a
# use case, and everything it catches is declared by the application.
[importlinter:contract:adapter-sides-independent]
name = Inbound adapters must not import outbound adapters
type = forbidden
source_modules =
    generic_ml_wrapper.adapter.inbound
forbidden_modules =
    generic_ml_wrapper.adapter.outbound
# Direct imports only. Reaching an outbound adapter *through the composition root* is not
# a leak — it is the composition root doing its job, and every command does it. What this
# forbids is an inbound adapter naming a concrete outbound one itself, which is how it
# ends up knowing which technology is installed.
allow_indirect_imports = true
